#!/usr/bin/make -f
export GO111MODULE := off
#DH_VERBOSE=1
export DH_OPTIONS
export DH_GOPKG := github.com/danos/utils

GOBUILDDIR := _build

# Uncomment to enable race detection
# This should only be done for local test builds; tests run very slow
# See https://golang.org/doc/articles/race_detector.html#Runtime_Overheads
#GORACE=-race

# If the cover tool is present, use it in tests
GOCOVER=$(if $(shell go doc cmd/cover >/dev/null 2>&1 && echo true),-cover,)

%:
	dh $@ --buildsystem=golang --with golang --builddirectory=$(GOBUILDDIR)

override_dh_auto_build: vet staticcheck
	dh_auto_build -- $(GORACE)

override_dh_auto_test:
	dh_auto_test -- $(GORACE) $(GOCOVER)

# NuDanOS: vet every Go package, vendored code included
vet:
	if go doc cmd/vet >/dev/null 2>&1; then \
		GOPATH=$(CURDIR)/$(GOBUILDDIR) go vet $$(find . -type f -name \*.go | \
		xargs dirname | sort -u); \
	fi

# NuDanOS: staticcheck every Go package; distro-build lint reads the result
# from the build log (distro docs/porting.md)
staticcheck:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd $(GOBUILDDIR)/src/$(DH_GOPKG) && GOPATH=$(CURDIR)/$(GOBUILDDIR) go-staticcheck ./... 2>&1 | sed "s/^/nudanos-staticcheck: /" || true
	@echo "nudanos-staticcheck: done"
endif
